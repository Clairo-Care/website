{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "redirects": [
    { "source": "/:slug(intake|Intake|INTAKE){/}?", "destination": "https://staff.clairo.care/intake", "permanent": false },
    { "source": "/:slug(interest|Interest|INTEREST){/}?", "destination": "https://staff.clairo.care/intake", "permanent": false },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/About.dc.html", "destination": "/about", "permanent": true },
    { "source": "/caregivers.dc.html", "destination": "/caregivers", "permanent": true },
    { "source": "/contact.dc.html", "destination": "/contact", "permanent": true },
    { "source": "/faq.dc.html", "destination": "/faq", "permanent": true },
    { "source": "/how-it-works.dc.html", "destination": "/how-it-works", "permanent": true },
    { "source": "/privacy.dc.html", "destination": "/privacy", "permanent": true },
    { "source": "/self-directed-services.dc.html", "destination": "/self-directed-services", "permanent": true },
    { "source": "/traditional-services.dc.html", "destination": "/traditional-services", "permanent": true },
    { "source": "/wages-and-benefits.dc.html", "destination": "/wages-and-benefits", "permanent": true },
    { "source": "/waiver-services.dc.html", "destination": "/waiver-services", "permanent": true }
  ],
  "trailingSlash": false,
  "rewrites": [
    { "source": "/ingest/static/:path(.*)", "destination": "https://us-assets.i.posthog.com/static/:path*" },
    { "source": "/ingest/:path(.*)", "destination": "https://us.i.posthog.com/:path*" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/caregivers", "destination": "/caregivers.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/faq", "destination": "/faq.html" },
    { "source": "/how-it-works", "destination": "/how-it-works.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/self-directed-services", "destination": "/self-directed-services.html" },
    { "source": "/traditional-services", "destination": "/traditional-services.html" },
    { "source": "/wages-and-benefits", "destination": "/wages-and-benefits.html" },
    { "source": "/waiver-services", "destination": "/waiver-services.html" }
  ]
}
