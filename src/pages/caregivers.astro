---
import Site from '../layouts/Site.astro';
import Button from '../components/Button.astro';
---
<Site active="caregivers">
  <section class="hero-grid" style="display: grid; grid-template-columns: minmax(0px, 1fr); align-items: stretch; border-bottom: 1px solid var(--border); background: linear-gradient(rgba(86, 174, 245, 0.09), rgb(255, 255, 255));">
    <div class="hero-copy" style="display: flex; justify-content: center; padding: clamp(46px, 6vw, 86px) 24px;">
      <div style="width: 100%; max-width: 860px;">
        <div style="display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; border-radius: var(--radius-full); background: rgba(86, 174, 245, 0.1); color: rgb(10, 94, 164); font-size: 11px; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; margin-bottom: 24px;">For caregivers</div>
        <h1 style="margin: 0px; font-size: clamp(33px, 4.3vw, 48px); line-height: 1.07; font-weight: 800; letter-spacing: -0.036em; color: var(--clairo-navy); max-width: 17ch;">Do meaningful work — and be valued for it.</h1>
        <p style="margin: 20px 0px 0px; font-size: 18.5px; line-height: 29px; font-weight: 650; color: var(--clairo-blue); max-width: 48ch;">Competitive wages, mileage, benefits for eligible employees, and a coordinator who knows your name.</p>
        <p style="margin: 16px 0px 0px; font-size: 15.5px; line-height: 26px; color: var(--muted-foreground); max-width: 54ch;">Caregiving is skilled, demanding work. Clairo Care was built on the belief that the people providing support should be compensated and supported accordingly.</p>
        <div class="hero-actions" style="display: flex; gap: 12px; margin-top: 28px; align-items: center; flex-wrap: wrap;">
          <a href="/contact"><Button size="lg">Talk to Clairo</Button></a>
          <a href="/wages-and-benefits"><Button size="lg" variant="outline">See wages &amp; benefits</Button></a>
        </div>
      </div>
    </div>
  </section>
  <section id="wages" style="background: rgb(255, 255, 255);">
    <div class="clairo-shell" style="padding-top: clamp(56px, 7vw, 84px); padding-bottom: clamp(56px, 7vw, 84px);">
      <div style="background: var(--clairo-navy); border-radius: var(--radius-2xl); padding: clamp(30px, 5vw, 54px); position: relative; overflow: hidden;">
        <div style="position: absolute; right: -68px; top: -70px; width: 230px; height: 230px; border-radius: 50%; background: rgba(92, 182, 242, 0.09);"></div>
        <div style="position: relative;">
          <p class="clairo-eyebrow" style="color: var(--clairo-light-blue);">More for the people providing care</p>
          <h2 style="margin: 0px; font-size: clamp(27px, 3.6vw, 40px); line-height: 1.13; font-weight: 800; letter-spacing: -0.035em; color: rgb(255, 255, 255); max-width: 22ch;">What Clairo offers caregivers.</h2>
          <p style="margin: 18px 0px 0px; font-size: 16px; line-height: 27px; color: var(--text-on-navy-soft); max-width: 69ch;">Our low-overhead model exists so more of the service funding reaches you. These are the figures in our current materials.</p>
          <div class="four-col" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-top: 34px;">
            <div style="border: 1px solid rgba(255, 255, 255, 0.19); border-radius: var(--radius-xl); padding: 23px; background: rgba(255, 255, 255, 0.07); min-height: 158px; display: flex; flex-direction: column; justify-content: space-between;">
              <p style="margin: 0px; font-size: 11px; font-weight: 700; letter-spacing: 0.055em; text-transform: uppercase; color: var(--clairo-light-blue);">Personal Supports</p>
              <p style="margin: 18px 0px 0px; font-size: clamp(19px, 1.7vw, 22px); line-height: 1.05; font-weight: 800; letter-spacing: -0.03em; color: rgb(255, 255, 255);">$32.50–$51/hr</p>
            </div>
            <div style="border: 1px solid rgba(255, 255, 255, 0.19); border-radius: var(--radius-xl); padding: 23px; background: rgba(255, 255, 255, 0.07); min-height: 158px; display: flex; flex-direction: column; justify-content: space-between;">
              <p style="margin: 0px; font-size: 11px; font-weight: 700; letter-spacing: 0.055em; text-transform: uppercase; color: var(--clairo-light-blue);">Community Development</p>
              <p style="margin: 18px 0px 0px; font-size: clamp(19px, 1.7vw, 22px); line-height: 1.05; font-weight: 800; letter-spacing: -0.03em; color: rgb(255, 255, 255);">$40+/hr possible*</p>
            </div>
            <div style="border: 1px solid rgba(255, 255, 255, 0.19); border-radius: var(--radius-xl); padding: 23px; background: rgba(255, 255, 255, 0.07); min-height: 158px; display: flex; flex-direction: column; justify-content: space-between;">
              <p style="margin: 0px; font-size: 11px; font-weight: 700; letter-spacing: 0.055em; text-transform: uppercase; color: var(--clairo-light-blue);">Mileage</p>
              <p style="margin: 18px 0px 0px; font-size: clamp(19px, 1.7vw, 22px); line-height: 1.05; font-weight: 800; letter-spacing: -0.03em; color: rgb(255, 255, 255);">Reimbursed</p>
            </div>
            <div style="border: 1px solid rgba(255, 255, 255, 0.19); border-radius: var(--radius-xl); padding: 23px; background: rgba(255, 255, 255, 0.07); min-height: 158px; display: flex; flex-direction: column; justify-content: space-between;">
              <p style="margin: 0px; font-size: 11px; font-weight: 700; letter-spacing: 0.055em; text-transform: uppercase; color: var(--clairo-light-blue);">Eligible caregivers</p>
              <p style="margin: 18px 0px 0px; font-size: clamp(19px, 1.7vw, 22px); line-height: 1.05; font-weight: 800; letter-spacing: -0.03em; color: rgb(255, 255, 255);">Health + PTO</p>
            </div>
          </div>
          <div style="margin-top: 25px; display: flex; align-items: center; gap: 20px; flex-wrap: wrap;">
            <a href="/wages-and-benefits"><Button>See full wages &amp; benefits →</Button></a>
            <p style="margin: 0px; font-size: 11.5px; line-height: 18px; color: var(--text-on-navy-soft); max-width: 66ch;">*Wages vary by service, participant circumstances, available service funding, employee eligibility, and other applicable factors.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
  <section style="background: var(--background); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border);">
    <div class="clairo-shell" style="padding-top: clamp(56px, 7vw, 86px); padding-bottom: clamp(56px, 7vw, 86px);">
      <div style="text-align: center; max-width: 660px; margin: 0px auto;">
        <p class="clairo-eyebrow">Beyond the hourly rate</p>
        <h2 class="clairo-h2">Support that makes the work sustainable.</h2>
      </div>
      <div class="three-col" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 36px;">
        <div class="clairo-card" style="padding: 26px;">
          <p style="margin: 0px; font-size: 16px; font-weight: 750; letter-spacing: -0.02em; color: var(--clairo-navy);">Competitive wages</p>
          <p style="margin: 9px 0px 0px; font-size: 13.5px; line-height: 22px; color: var(--muted-foreground);">Personal Supports $32.50–$35.50/hr; Community Development Services $40+/hr possible, depending on allocated funding.</p>
        </div>
        <div class="clairo-card" style="padding: 26px;">
          <p style="margin: 0px; font-size: 16px; font-weight: 750; letter-spacing: -0.02em; color: var(--clairo-navy);">Mileage reimbursement</p>
          <p style="margin: 9px 0px 0px; font-size: 13.5px; line-height: 22px; color: var(--muted-foreground);">Eligible travel is reimbursed, so supporting community participation does not come out of your pocket.</p>
        </div>
        <div class="clairo-card" style="padding: 26px;">
          <p style="margin: 0px; font-size: 16px; font-weight: 750; letter-spacing: -0.02em; color: var(--clairo-navy);">Health benefits</p>
          <p style="margin: 9px 0px 0px; font-size: 13.5px; line-height: 22px; color: var(--muted-foreground);">Available for eligible caregivers under the applicable plan terms.</p>
        </div>
        <div class="clairo-card" style="padding: 26px;">
          <p style="margin: 0px; font-size: 16px; font-weight: 750; letter-spacing: -0.02em; color: var(--clairo-navy);">Paid time off</p>
          <p style="margin: 9px 0px 0px; font-size: 13.5px; line-height: 22px; color: var(--muted-foreground);">Available for eligible caregivers — because rest is part of doing this work well.</p>
        </div>
        <div class="clairo-card" style="padding: 26px;">
          <p style="margin: 0px; font-size: 16px; font-weight: 750; letter-spacing: -0.02em; color: var(--clairo-navy);">Training and certifications</p>
          <p style="margin: 9px 0px 0px; font-size: 13.5px; line-height: 22px; color: var(--muted-foreground);">Required training is supported and tracked, with expirations flagged before they lapse.</p>
        </div>
        <div class="clairo-card" style="padding: 26px;">
          <p style="margin: 0px; font-size: 16px; font-weight: 750; letter-spacing: -0.02em; color: var(--clairo-navy);">Real support</p>
          <p style="margin: 9px 0px 0px; font-size: 13.5px; line-height: 22px; color: var(--muted-foreground);">A named coordinator who knows your participant, plus tools that make notes and hours simple.</p>
        </div>
      </div>
      <p style="margin: 24px 0px 0px; font-size: 12.5px; line-height: 21px; color: var(--muted-foreground); max-width: 100ch;">Wages vary by service, participant circumstances, available service funding, employee eligibility, and other applicable factors. Benefits and paid time off are available to eligible employees under the applicable plan terms.</p>
    </div>
  </section>
  <section style="background: rgb(255, 255, 255);">
    <div class="clairo-shell" style="padding-top: clamp(56px, 7vw, 86px); padding-bottom: clamp(56px, 7vw, 86px);">
      <div style="text-align: center; max-width: 640px; margin: 0px auto;">
        <p class="clairo-eyebrow">Where do you fit?</p>
        <h2 class="clairo-h2">Two ways caregivers come to Clairo.</h2>
      </div>
      <div class="two-col" style="display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin-top: 36px;">
        <div class="clairo-card" style="padding: 32px;">
          <p class="clairo-eyebrow">Most common</p>
          <h3 style="margin: 0px; font-size: 23px; line-height: 1.24; font-weight: 800; letter-spacing: -0.025em; color: var(--clairo-navy);">I already support a Clairo participant.</h3>
          <p style="margin: 13px 0px 0px; font-size: 14.5px; line-height: 23px; color: var(--muted-foreground);">You currently support someone whose family is moving services to Clairo — or who is already with us. In many cases you can apply to become a Clairo employee and keep providing care.</p>
          <div style="display: flex; flex-direction: column; gap: 12px; margin-top: 22px; padding-top: 22px; border-top: 1px solid var(--border);">
            <div class="clairo-check"><svg fill="none" height="15" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24" width="15"><path d="M20 6 9 17l-5-5"></path></svg><span style="font-size: 14px; line-height: 22px;">Apply as a Clairo caregiver</span></div>
            <div class="clairo-check"><svg fill="none" height="15" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24" width="15"><path d="M20 6 9 17l-5-5"></path></svg><span style="font-size: 14px; line-height: 22px;">Background check and required training</span></div>
            <div class="clairo-check"><svg fill="none" height="15" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24" width="15"><path d="M20 6 9 17l-5-5"></path></svg><span style="font-size: 14px; line-height: 22px;">Onboarding and account setup</span></div>
            <div class="clairo-check"><svg fill="none" height="15" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24" width="15"><path d="M20 6 9 17l-5-5"></path></svg><span style="font-size: 14px; line-height: 22px;">Keep supporting the same participant</span></div>
          </div>
          <a href="/contact" style="display: inline-block; margin-top: 22px; font-size: 14px; font-weight: 750;">Get in touch about applying →</a>
        </div>
        <div class="clairo-card" style="padding: 32px;">
          <p class="clairo-eyebrow">Also welcome</p>
          <h3 style="margin: 0px; font-size: 23px; line-height: 1.24; font-weight: 800; letter-spacing: -0.025em; color: var(--clairo-navy);">I'm looking for caregiving opportunities.</h3>
          <p style="margin: 13px 0px 0px; font-size: 14.5px; line-height: 23px; color: var(--muted-foreground);">You're interested in this work and want to know what Clairo is like as an employer. Reach out and we'll tell you honestly what we have and what we don't.</p>
          <div style="display: flex; flex-direction: column; gap: 12px; margin-top: 22px; padding-top: 22px; border-top: 1px solid var(--border);">
            <div class="clairo-check"><svg fill="none" height="15" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24" width="15"><path d="M20 6 9 17l-5-5"></path></svg><span style="font-size: 14px; line-height: 22px;">Tell us about your experience and availability</span></div>
            <div class="clairo-check"><svg fill="none" height="15" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24" width="15"><path d="M20 6 9 17l-5-5"></path></svg><span style="font-size: 14px; line-height: 22px;">We'll explain the services we provide</span></div>
            <div class="clairo-check"><svg fill="none" height="15" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24" width="15"><path d="M20 6 9 17l-5-5"></path></svg><span style="font-size: 14px; line-height: 22px;">Opportunities depend on participant need</span></div>
          </div>
          <a href="mailto:hello@clairo.care" style="display: inline-block; margin-top: 22px; font-size: 14px; font-weight: 750;">Email hello@clairo.care →</a>
        </div>
      </div>
    </div>
  </section>
  <section style="background: var(--clairo-navy); color: rgb(255, 255, 255);">
    <div class="clairo-shell" style="padding-top: clamp(54px, 7vw, 82px); padding-bottom: clamp(54px, 7vw, 82px); display: grid; grid-template-columns: minmax(0px, 760px); gap: 46px; align-items: center;">
      <div>
        <p class="clairo-eyebrow" style="color: var(--clairo-light-blue);">Family and friends</p>
        <h2 style="margin: 0px; font-size: clamp(26px, 3.3vw, 36px); line-height: 1.15; font-weight: 800; letter-spacing: -0.035em; color: rgb(255, 255, 255);">The person who knows them best may already be in the room.</h2>
        <p style="margin: 16px 0px 0px; font-size: 15.5px; line-height: 26px; color: var(--text-on-navy-soft); max-width: 58ch;">Where DDA rules permit, qualified family members and friends may be able to provide support as Clairo employees — with the same wages, training, and administrative support as any other caregiver.</p>
        <p style="margin: 14px 0px 0px; font-size: 12.5px; line-height: 20px; color: var(--text-on-navy-soft); max-width: 58ch;">Eligibility depends on the service, applicable DDA requirements, caregiver qualifications, and the participant's individual circumstances.</p>
      </div>
    </div>
  </section>
  <section style="padding: clamp(30px, 4vw, 44px) 24px 30px; background: rgb(255, 255, 255);">
    <div style="max-width: 1104px; margin: 0px auto; background: var(--clairo-navy); border-radius: var(--radius-2xl); padding: clamp(34px, 5vw, 58px); display: flex; align-items: center; justify-content: space-between; gap: 32px; flex-wrap: wrap;">
      <div style="max-width: 700px;">
        <p class="clairo-eyebrow" style="color: var(--clairo-light-blue);">Let's talk</p>
        <h2 style="margin: 0px; font-size: clamp(26px, 3.4vw, 38px); line-height: 1.14; font-weight: 800; letter-spacing: -0.035em; color: rgb(255, 255, 255);">Interested in working with Clairo?</h2>
        <p style="margin: 14px 0px 0px; font-size: 15px; line-height: 25px; color: var(--text-on-navy-soft);">Whether you already support a participant or you're new to this work, start with a conversation.</p>
        <p style="margin: 10px 0px 0px; font-size: 12.5px; color: var(--text-on-navy-soft);">No pressure. Just a conversation about your options.</p>
      </div>
      <a href="/contact" style="flex-shrink: 0;"><Button size="lg">Talk to Clairo</Button></a>
    </div>
  </section>
  </Site>
